<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-vc">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!-- Launch screen: the Home backdrop, aspect-filled, under a flat scrim
             that approximates Home's gradient so the hand-off is seamless. -->
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-vc" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="HomeBackdrop" translatesAutoresizingMaskIntoConstraints="NO" id="launch-image">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="launch-scrim">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                                <color key="backgroundColor" red="0.078" green="0.125" blue="0.114" alpha="0.45" colorSpace="custom" customColorSpace="sRGB"/>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe"/>
                        <color key="backgroundColor" red="0.118" green="0.180" blue="0.165" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-image" firstAttribute="top" secondItem="launch-root" secondAttribute="top" id="ci-top"/>
                            <constraint firstItem="launch-image" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="ci-lead"/>
                            <constraint firstAttribute="trailing" secondItem="launch-image" secondAttribute="trailing" id="ci-trail"/>
                            <constraint firstAttribute="bottom" secondItem="launch-image" secondAttribute="bottom" id="ci-bottom"/>
                            <constraint firstItem="launch-scrim" firstAttribute="top" secondItem="launch-root" secondAttribute="top" id="cs-top"/>
                            <constraint firstItem="launch-scrim" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="cs-lead"/>
                            <constraint firstAttribute="trailing" secondItem="launch-scrim" secondAttribute="trailing" id="cs-trail"/>
                            <constraint firstAttribute="bottom" secondItem="launch-scrim" secondAttribute="bottom" id="cs-bottom"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="HomeBackdrop" width="846" height="1859"/>
    </resources>
</document>
